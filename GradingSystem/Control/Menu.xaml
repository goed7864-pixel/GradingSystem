<UserControl x:Class="GradingSystem.Control.Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="230">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/buttonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#FFFFFF"
            CornerRadius="30,0,0,30">

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,50">
                <TextBlock Text="ТопЗагрузка"
                           Margin="15,4,0,0"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2B2B2B"/>
            </StackPanel>

            <!-- Menu -->
            <StackPanel Grid.Row="1">

                <Border x:Name="HomeButtonBorder"
                        Background="Transparent"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,10"
                        Cursor="Hand"
                        MouseLeftButtonDown="HomeButton_Click">
                    <TextBlock Text="Главная"
                               FontSize="15"
                               Foreground="#7D7D88"/>
                </Border>

                <Border x:Name="CoursesButtonBorder"
                        Background="Transparent"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,10"
                        Cursor="Hand"
                        MouseLeftButtonDown="CoursesButton_Click">
                    <TextBlock Text="Курсы"
                               FontSize="15"
                               Foreground="#7D7D88"/>
                </Border>

                <Border x:Name="GroupsButtonBorder"
                        Background="Transparent"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,10"
                        Cursor="Hand"
                        MouseLeftButtonDown="GroupsButton_Click">
                    <TextBlock Text="Группы"
                               FontSize="15"
                               Foreground="#7D7D88"/>
                </Border>

                <Border x:Name="AssignmentsButtonBorder"
                        Background="Transparent"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,10"
                        Cursor="Hand"
                        MouseLeftButtonDown="AssignmentsButton_Click">
                    <TextBlock Text="Задания"
                               FontSize="15"
                               Foreground="#7D7D88"/>
                </Border>

            </StackPanel>

            <!-- Help Card -->
            <Border Grid.Row="2"
                    Margin="0,20,0,0">

                <StackPanel>
                   
                    <Button x:Name="ExitButton"
                            Content="Выйти"
                            Style="{StaticResource AccentButton}"
                            Height="40"
                            Margin="0,15,0,0"
                            Click="ExitButton_Click"/>

                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>