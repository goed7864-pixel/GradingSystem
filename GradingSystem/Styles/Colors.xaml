<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!-- COLOR PALETTE -->
    <!-- ========================= -->

    <!-- Primary Colors (Menu) -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#5ED0BA"/>
    <SolidColorBrush x:Key="PrimaryDarkColor" Color="#22AA90"/>
    <SolidColorBrush x:Key="PrimaryLightColor" Color="#7FDDC9"/>

    <!-- Accent Color (Important/Alert) -->
    <SolidColorBrush x:Key="AccentColor" Color="#D91842"/>
    <SolidColorBrush x:Key="AccentDarkColor" Color="#C01538"/>
    <SolidColorBrush x:Key="AccentLightColor" Color="#FFE8EE"/>

    <!-- Background Colors -->
    <SolidColorBrush x:Key="BackgroundColor" Color="#F6F6F8"/>
    <SolidColorBrush x:Key="BackgroundDarkColor" Color="#D8D9E0"/>

    <!-- White Shades -->
    <SolidColorBrush x:Key="WhiteColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WhiteSoftColor" Color="#F7F7FB"/>
    <SolidColorBrush x:Key="WhiteGrayColor" Color="#EEF1FF"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#7D7D88"/>
    <SolidColorBrush x:Key="TextLightColor" Color="#888888"/>
    <SolidColorBrush x:Key="TextDisabledColor" Color="#CCCCCC"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BorderLightColor" Color="#F0F0F0"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessColor" Color="#5ED0BA"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFA726"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#D91842"/>
    <SolidColorBrush x:Key="InfoColor" Color="#5677D8"/>

    <!-- ========================= -->
    <!-- SHADOW EFFECTS -->
    <!-- ========================= -->

    <DropShadowEffect x:Key="CardShadow"
                      Color="#000000"
                      Opacity="0.08"
                      BlurRadius="15"
                      ShadowDepth="2"/>

    <DropShadowEffect x:Key="LightShadow"
                      Color="#000000"
                      Opacity="0.05"
                      BlurRadius="10"
                      ShadowDepth="1"/>

    <DropShadowEffect x:Key="HoverShadow"
                      Color="#000000"
                      Opacity="0.12"
                      BlurRadius="20"
                      ShadowDepth="5"/>

</ResourceDictionary>
