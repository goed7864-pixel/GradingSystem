                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#5ED0BA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>