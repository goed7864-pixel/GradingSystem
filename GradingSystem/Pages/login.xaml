<Window x:Class="GradingSystem.login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F6F6F8">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/textBoxStyles.xaml"/>
                <ResourceDictionary Source="/Styles/buttonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="60">

        <Border Background="White"
                CornerRadius="30"
                Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="30" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#5ED0BA"
                        CornerRadius="30,0,0,30"
                        Padding="70">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Система оценивания"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,30"/>

                        

                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="80">

                    <StackPanel VerticalAlignment="Center">



                        <TextBlock x:Name="SubtitleText"
                                   Text="Войдите в свой аккаунт"
                                   FontSize="30"
                                   Foreground="#7D7D88"
                                   Margin="0,0,0,50"/>

                        <TextBlock Text="Email"
                                   FontSize="14"
                                   Foreground="#7D7D88"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="EmailBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="55"
                                 FontSize="16"
                                 Margin="0,0,0,25"/>

                        <TextBlock Text="Пароль"
                                   FontSize="14"
                                   Foreground="#7D7D88"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Height="55"
                                     FontSize="16"
                                     Margin="0,0,0,15"/>

                        <Button x:Name="LoginButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="ВОЙТИ"
                                Click="LoginButton_Click"
                                Height="55"
                                FontSize="16"
                                Margin="0,0,0,20"/>

                        <Button x:Name="TestConnectionButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Проверить подключение"
                                Click="TestConnectionButton_Click"
                                Height="50"
                                FontSize="15"
                                Margin="0,0,0,25"/>

                        <Border Height="70"
                                Margin="0,15,0,0">
                            <Border x:Name="ErrorPanel"
                                    Background="#FFE8EE"
                                    CornerRadius="12"
                                    Padding="18"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=""
                                               FontSize="16"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="13"
                                               Foreground="#D91842"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>