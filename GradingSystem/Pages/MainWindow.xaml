<Window x:Class="GradingSystem.Pages.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GradingSystem.Pages"
        xmlns:control="clr-namespace:GradingSystem.Control"
        mc:Ignorable="d"
        Title="Система оценивания"
        Height="850"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#D8D9E0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/buttonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="30">

        <!-- Main Card -->
        <Border Background="#F6F6F8"
                CornerRadius="30"
                Padding="0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar with Menu Component -->
                <control:Menu x:Name="MenuControl" Grid.Column="0" NavigationRequested="Menu_NavigationRequested"/>

                <!-- Main Content Area -->
                <Frame x:Name="MainFrame"
                       Grid.Column="1"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"
                       Margin="0"/>

            </Grid>
        </Border>
    </Grid>
</Window>