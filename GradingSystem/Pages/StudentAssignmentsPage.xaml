<Page x:Class="GradingSystem.Pages.StudentAssignmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GradingSystem.Pages"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1200"
      Background="#F5F5F5">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/cardStyles.xaml"/>
                <ResourceDictionary Source="/Styles/buttonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Мои задания" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Просмотр и загрузка заданий" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Style="{StaticResource RefreshButton}" Click="RefreshButton_Click" ToolTip="Обновить данные">
                    <TextBlock Text="🔄" FontSize="18" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,20,25,20">

                <!-- Фильтры -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Поиск -->
                        <Border Grid.Column="0" Style="{StaticResource SearchBoxBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Foreground="#999" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchTextBox}" TextChanged="SearchBox_TextChanged" Text="" />
                            </Grid>
                        </Border>

                        <!-- Фильтр по статусу -->
                        <ComboBox Grid.Column="2" x:Name="StatusFilterComboBox" Width="200" Height="38" SelectionChanged="StatusFilter_Changed" FontSize="13">
                            <ComboBoxItem Content="Все задания" IsSelected="True"/>
                            <ComboBoxItem Content="К выполнению"/>
                            <ComboBoxItem Content="Выполнено"/>
                            <ComboBoxItem Content="Просрочено"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Список заданий -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Список заданий" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                        <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AssignmentsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFA" CornerRadius="10" Padding="20" Margin="0,0,0,12" BorderBrush="#EEEEEE" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Заголовок задания -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding CourseName}" FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Описание -->
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="13" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                <!-- Информация и действия -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Border Background="#FFF3E0" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📅" FontSize="12" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding Deadline}" FontSize="12" Foreground="#FF9800" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#E3F2FD" CornerRadius="8" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="⭐" FontSize="12" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding MaxScore}" FontSize="12" Foreground="#2196F3" FontWeight="SemiBold"/>
                                                                <TextBlock Text=" баллов" FontSize="12" Foreground="#2196F3"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <!-- Кнопка загрузки (показывается если не выполнено) -->
                                                        <Button Content="📤 Загрузить работу"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Background="#4CAF50"
                                                                Padding="15,8"
                                                                FontSize="13"
                                                                Click="UploadAssignment_Click"
                                                                Tag="{Binding Id}"
                                                                Margin="0,0,10,0">
                                                            <Button.Visibility>
                                                                <Binding Path="Status">
                                                                    <Binding.Converter>
                                                                        <local:StatusToVisibilityConverter ShowForStatus="Выполнено" Invert="True"/>
                                                                    </Binding.Converter>
                                                                </Binding>
                                                            </Button.Visibility>
                                                        </Button>

                                                        <!-- Кнопка удаления (показывается если выполнено) -->
                                                        <Button Content="🗑️ Удалить работу"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Background="#F44336"
                                                                Padding="15,8"
                                                                FontSize="13"
                                                                Click="DeleteAssignment_Click"
                                                                Tag="{Binding Id}">
                                                            <Button.Visibility>
                                                                <Binding Path="Status">
                                                                    <Binding.Converter>
                                                                        <local:StatusToVisibilityConverter ShowForStatus="Выполнено" Invert="False"/>
                                                                    </Binding.Converter>
                                                                </Binding>
                                                            </Button.Visibility>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="NoAssignmentsMessage" Text="Нет заданий" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
