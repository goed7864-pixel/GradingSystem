<Window x:Class="GradingSystem.Pages.AddAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавить задание"
        Height="700"
        Width="600"
        Style="{StaticResource DialogWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/windowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource DialogContentBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Создание нового задания" Style="{StaticResource DialogTitle}"/>

                    <TextBlock Text="Название задания" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="TitleTextBox" Style="{StaticResource DialogTextBox}"/>

                    <TextBlock Text="Описание" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="DescriptionTextBox"
                             Height="100"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource DialogTextBox}"
                             VerticalContentAlignment="Top"
                             Padding="15,10"/>

                    <TextBlock Text="Максимальный балл" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="MaxPointsTextBox" Style="{StaticResource DialogTextBox}"/>

                    <TextBlock Text="Дедлайн" Style="{StaticResource DialogLabel}"/>
                    <DatePicker x:Name="DeadlinePicker"
                                Height="50"
                                FontSize="15"
                                Margin="0,0,0,25"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="CancelButton"
                                Grid.Column="0"
                                Content="Отмена"
                                Style="{StaticResource DialogCancelButton}"
                                Click="CancelButton_Click"/>

                        <Button x:Name="SaveButton"
                                Grid.Column="2"
                                Content="Создать"
                                Style="{StaticResource DialogSaveButton}"
                                Click="SaveButton_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
